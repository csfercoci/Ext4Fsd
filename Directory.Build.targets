<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" InitialTargets="WdkDiag">
  <!--
    When the WDK kernel toolset (WindowsKernelModeDriver10.0) is missing
    for x64, IncludePath doesn't contain the km/shared dirs and ntifs.h
    is not found.  Always inject WDK include paths from the registry
    when the KitsRoot10 key exists and the km directory is present.
  -->
  <Target Name="WdkDiag">
    <Message Importance="high" Text="Directory.Build.targets: KitsRoot10=$(Registry:HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots@KitsRoot10) WindowsTargetPlatformVersion=$(WindowsTargetPlatformVersion)" />
  </Target>
  <PropertyGroup>
    <_WdkRoot>$(Registry:HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots@KitsRoot10)</_WdkRoot>
    <_WdkRoot Condition="!HasTrailingSlash('$(_WdkRoot)')">$(_WdkRoot)\</_WdkRoot>
    <_WdkVersion Condition="'$(WindowsTargetPlatformVersion)' != ''">$(WindowsTargetPlatformVersion)</_WdkVersion>
    <_WdkVersion Condition="'$(WindowsTargetPlatformVersion)' == ''">10.0.26100.0</_WdkVersion>
    <_WdkKm>$(_WdkRoot)Include\$(_WdkVersion)\km</_WdkKm>
    <_WdkShared>$(_WdkRoot)Include\$(_WdkVersion)\shared</_WdkShared>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="Exists('$(_WdkKm)')">
    <ClCompile>
      <AdditionalIncludeDirectories>$(_WdkKm);$(_WdkShared);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <!--
    Fail fast with one clear message instead of a C1083 'ntifs.h' per
    translation unit when a kernel-mode project is built on a machine
    without the WDK (e.g. GitHub windows-2025 runners, which ship the
    SDK but not the WDK).
  -->
  <Target Name="WdkEnsureKmHeaders" BeforeTargets="ClCompile"
          Condition="'$(PlatformToolset)' == 'WindowsKernelModeDriver10.0' And !Exists('$(_WdkKm)')">
    <Error Text="WDK kernel headers not found at '$(_WdkKm)'. Install the Windows Driver Kit for $(_WdkVersion) (CI does this in the 'Install WDK' step of .github/workflows/build.yml)." />
  </Target>
</Project>
